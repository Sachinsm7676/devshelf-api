# DevShelf API configuration. Every variable is optional; the defaults suit `docker compose up`.
# The app reads real environment variables only - this file is documentation, not loaded automatically.

# HTTP port. Render injects this.
PORT=8080

# PostgreSQL as one URL (what Render provides): postgresql://user:password@host[:port]/database
# When set, it wins over the DB_* variables below.
# DATABASE_URL=

# PostgreSQL connection (jdbc:postgresql://DB_HOST:DB_PORT/DB_NAME)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devshelf
DB_USERNAME=devshelf
DB_PASSWORD=devshelf
# Max JDBC connections (free-tier databases have a small connection limit)
DB_POOL_SIZE=5

# Browser origins allowed to call /api/** (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Zone that defines "today" when rejecting future published dates
APP_TIMEZONE=Asia/Kolkata
